<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
    ExtensionBundleId="com.ghostae.caption"
    ExtensionBundleVersion="1.2.3"
    ExtensionBundleName="Ghostae Caption"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.ghostae.caption" Version="1.2.3" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList><Host Name="AEFT" Version="[16.0,99.9]" /></HostList>
        <LocaleList><Locale Code="All" /></LocaleList>
        <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0" /></RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.ghostae.caption">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./js/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--enable-media-stream</Parameter>
                        <Parameter>--use-fake-ui-for-media-stream</Parameter>
                        <Parameter>--allow-insecure-localhost</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Ghostae Caption</Menu>
                    <Geometry>
                        <Size><Width>480</Width><Height>560</Height></Size>
                        <MinSize><Width>360</Width><Height>420</Height></MinSize>
                        <MaxSize><Width>1600</Width><Height>2160</Height></MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
